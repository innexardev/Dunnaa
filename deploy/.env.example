# ─── Copie para deploy/.env no servidor (NUNCA commite o .env real) ───────────
# cp .env.example .env && nano .env

# Rede Docker do Traefik (mesmo nome da rede external no host)
TRAEFIK_NETWORK=fixelo_fixelo-network

# PostgreSQL
POSTGRES_DB=dunnaa
POSTGRES_USER=dunnaa
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# API — segurança (gere: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM
ADMIN_TOKEN=CHANGE_ME_ADMIN_DEBUG_TOKEN

# Stripe (produção)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Observabilidade
SENTRY_DSN=
LOG_FORMAT=json
LOG_LEVEL=INFO

# SMS nVoIP (OTP produção)
NVOIP_TOKEN=
NVOIP_FROM_NUMBER=
SMS_ENABLED=true

# Storage S3/R2 (opcional)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=dunnaa
S3_PUBLIC_URL=https://cdn.dunnaa.com.br
